# Copy this file to .env or export these variables before running the app.
# The assistant works WITHOUT any key (rule-based contextual Q&A).
# Set a key to enable model-generated answers in the Ask page.

OPENAI_API_KEY=sk-your-key-here
# Optional: any OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: model name
AI_MODEL=gpt-4o-mini
